# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# VITE_API_URL: samo za lokalni dev ako koristiš drugi port. Na Netlify nije potrebno (same-origin).
VITE_API_URL=http://localhost:3000
# API ključ za zaštitu – isti kao API_SECRET (frontend ga šalje u headeru)
VITE_API_KEY=tvoj-tajni-kljuc-ovde
# Bypass za admin: ?bypass=tajna-vrednost u URL-u omogućava pristup bez email parametra
VITE_ADMIN_BYPASS=
# Bubble: URL workflow-a za ažuriranje potrošnje reči (npr. https://...bubbleapps.io/api/1.1/wf/update_word_usage?api_token=XXX). Dodaje se &user_email=... i &words=...
VITE_BUBBLE_UPDATE_WORDS_URL=

# ─── Backend (API ključevi – NIKAD ne stavljaj u frontend) ─────────────────────
# Zaštita: samo zahtevi sa ovim ključem u X-API-Key headeru prolaze
API_SECRET=tvoj-tajni-kljuc-ovde
# OpenAI – ChatGPT 5.2
OPENAI_API_KEY=sk-proj-...

# Anthropic – Claude Sonnet 4.5 / 4.6
ANTHROPIC_API_KEY=sk-ant-...

# Google – Gemini 2.5 Pro
GOOGLE_GEMINI_API_KEY=

# Supabase (istorija objava) – service role SAMO na backendu, nikad u frontend
VITE_SUPABASE_URL=https://tvoj-projekat.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=
